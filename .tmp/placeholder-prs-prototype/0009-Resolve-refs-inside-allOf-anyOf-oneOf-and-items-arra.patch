From 0208ca2c81efaeb9829c8cbd28b1a2a19d0dc674 Mon Sep 17 00:00:00 2001
From: Frank Reichenbach <frank.w.reichenbach@web.de>
Date: Tue, 3 Nov 2026 14:19:41 +0100
Subject: [PATCH 09/11] Resolve refs inside allOf, anyOf, oneOf and items
 arrays against their $id

walk() descended only into object values, so it skipped the arrays of
allOf, anyOf, oneOf and an array-form items. A $ref inside them wasn't
resolved against the $id of its subschema. The generator resolved it
later against the base URI of the function it was generating, which
ignores every $id in between. An $id inside them wasn't registered,
so a $ref to it was loaded through a handler or urlopen.

subschemas() now also yields the subschemas in these arrays. It still
skips the values of data keywords, so an allOf inside a const value
stays data.

Every case in draft6 and draft7 ref.json of the JSON-Schema-Test-Suite
passes now, so ref.json is no longer marked as an expected failure
for these drafts.

_expand_refs(), which builds the definition of a
JsonSchemaValueException, now follows the same rules: it expands the
$refs in these arrays and leaves arrays of other keywords as they are.
It used to resolve a $ref in any array, for example in an unknown
keyword, which could load it through a handler at compile time.

An id inside these arrays now sets the base URI there too. That is
what walk() already does for every other subschema, in every draft,
although draft-06 and later don't define id. The CHANGELOG says so.

The tests are in tests/test_ref_arrays.py.
---
 CHANGELOG.txt                     |   4 +
 fastjsonschema/generator.py       |  10 +-
 fastjsonschema/ref_resolver.py    |  12 ++-
 tests/json_schema/test_draft06.py |   3 -
 tests/json_schema/test_draft07.py |   1 -
 tests/test_ref_arrays.py          | 155 ++++++++++++++++++++++++++++++
 6 files changed, 173 insertions(+), 12 deletions(-)
 create mode 100644 tests/test_ref_arrays.py

diff --git a/CHANGELOG.txt b/CHANGELOG.txt
index 33146c6..3c07ea2 100644
--- a/CHANGELOG.txt
+++ b/CHANGELOG.txt
@@ -9,6 +9,10 @@
 * Fixed refs starting with `#` (`#`, `#/definitions/...`, plain names like `#foo`) inside a subschema whose `$id` has a scheme such as `urn:` resolving against the root schema instead of that subschema, unlike with an `http` `$id`
 * Changed such a ref whose target exists only in the root schema to raise `JsonSchemaDefinitionException` at compile time, as with an `http` `$id`
 * Changed the names of the functions generated for refs starting with `#` when the root `$id` has such a scheme (visible in `compile_to_code()`)
+* Fixed `compile()` and `compile_to_code()` rewriting the `$ref` values of the schema in place, so that compiling an object again under another `$id`, or as part of another schema, used the base URI of the first compilation. A `$ref` inside the `definition` of a `JsonSchemaValueException` now shows the value as written in the schema
+* Fixed refs inside `allOf`, `anyOf`, `oneOf` and an array-form `items` ignoring the `$id` of their subschema, and an `$id` inside them not being registered
+* Changed an `id` inside `allOf`, `anyOf`, `oneOf` and an array-form `items` to set the base URI there as well, as it already does in every other subschema and in every draft (draft-06 and later don't define `id`)
+* Changed the `definition` of a `JsonSchemaValueException` to keep the `$ref`s inside arrays of other keywords as written. They were resolved at compile time, which could load them through a handler
 
 === 2.22.3 (2026-11-01)
 
diff --git a/fastjsonschema/generator.py b/fastjsonschema/generator.py
index b1ea98c..809d34d 100644
--- a/fastjsonschema/generator.py
+++ b/fastjsonschema/generator.py
@@ -5,7 +5,7 @@ import re
 
 from .exceptions import JsonSchemaValueException, JsonSchemaValuesException, JsonSchemaDefinitionException
 from .indent import indent
-from .ref_resolver import DATA_KEYWORDS, SCHEMA_MAPS, RefResolver
+from .ref_resolver import DATA_KEYWORDS, SCHEMA_ARRAYS, SCHEMA_MAPS, RefResolver
 
 # Both mean "this subschema did not match": a subschema behind a $ref becomes its own
 # function, which reports through JsonSchemaValuesException while errors are collected.
@@ -324,8 +324,6 @@ class CodeGenerator:
         self.l(msg, *args, definition=repr_default(definition), rule=repr(rule), definition_rule=definition_rule)
 
     def _expand_refs(self, definition):
-        if isinstance(definition, list):
-            return [self._expand_refs(v) for v in definition]
         if not isinstance(definition, dict):
             return definition
         if "$ref" in definition and isinstance(definition["$ref"], str):
@@ -337,12 +335,14 @@ class CodeGenerator:
             except ValueError:
                 # Not a valid URI: shown as written. If the $ref is used, generate_ref() reports it.
                 return definition
-        # The same rules as in ref_resolver.subschemas: data stays as it is, and the
-        # names in a map of schemas are names, not keywords.
+        # The same rules as in ref_resolver.subschemas: data stays as it is, the names in
+        # a map of schemas are names, not keywords, and only some keywords hold arrays of schemas.
         expanded = {}
         for key, value in definition.items():
             if key in DATA_KEYWORDS:
                 expanded[key] = value
+            elif key in SCHEMA_ARRAYS and isinstance(value, list):
+                expanded[key] = [self._expand_refs(sub) for sub in value]
             elif key in SCHEMA_MAPS and isinstance(value, dict):
                 expanded[key] = {name: self._expand_refs(sub) for name, sub in value.items()}
             else:
diff --git a/fastjsonschema/ref_resolver.py b/fastjsonschema/ref_resolver.py
index 588d062..f9324ac 100644
--- a/fastjsonschema/ref_resolver.py
+++ b/fastjsonschema/ref_resolver.py
@@ -21,6 +21,8 @@ from .exceptions import JsonSchemaDefinitionException
 
 # keywords whose values are data, not schemas
 DATA_KEYWORDS = ('const', 'default', 'enum', 'examples')
+# keywords whose values can be arrays of schemas (`items` can also be one schema)
+SCHEMA_ARRAYS = ('allOf', 'anyOf', 'oneOf', 'items')
 # keywords whose values map names to schemas
 SCHEMA_MAPS = ('$defs', 'definitions', 'dependencies', 'dependentSchemas', 'patternProperties', 'properties')
 MAX_SCHEMA_WALK_DEPTH = min(500, sys.getrecursionlimit() // 2)
@@ -63,13 +65,17 @@ def subschemas(node: dict[str, Any]) -> Iterator[tuple[dict[str, Any], int]]:
     Yield the subschemas of ``node`` that are objects, with how many levels below ``node`` they are.
     """
     for key, item in node.items():
-        if key in DATA_KEYWORDS or not isinstance(item, dict):
+        if key in DATA_KEYWORDS:
             continue
-        if key in SCHEMA_MAPS:
+        if key in SCHEMA_ARRAYS and isinstance(item, list):
+            for sub in item:
+                if isinstance(sub, dict):
+                    yield sub, 2
+        elif key in SCHEMA_MAPS and isinstance(item, dict):
             for sub in item.values():
                 if isinstance(sub, dict):
                     yield sub, 2
-        else:
+        elif isinstance(item, dict):
             yield item, 1
 
 
