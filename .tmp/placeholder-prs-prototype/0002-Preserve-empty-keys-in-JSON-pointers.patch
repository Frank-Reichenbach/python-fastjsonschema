Date: Thu, 5 Nov 2026 09:07:54 +0100
Subject: [PATCH 02/11] Preserve empty keys in JSON pointers

---
 CHANGELOG.txt                  |  1 +
 fastjsonschema/ref_resolver.py |  6 ++-
 tests/test_ref_pointer.py      | 82 ++++++++++++++++++++++++++++++++++
 3 files changed, 87 insertions(+), 2 deletions(-)
 create mode 100644 tests/test_ref_pointer.py

diff --git a/CHANGELOG.txt b/CHANGELOG.txt
index 98ea429..d74fb83 100644
--- a/CHANGELOG.txt
+++ b/CHANGELOG.txt
@@ -1,5 +1,6 @@
 === UNRELEASED
 
+* Fixed JSON pointers with an empty key, such as `#/` and `#//child`: leading empty keys were dropped, so `#/` meant the whole document
 * Fixed two refs whose targets differ only in case or punctuation (such as `#/definitions/user-id` and `#/definitions/user_id`) calling the same generated function, so that a `$ref` validated against the wrong schema, and `compile()` could return the validator of a referenced schema instead of the whole schema
 * Fixed `NameError` during validation and `ValueError` at compile time for two spellings of one URI, such as `?#/definitions/ab` and `#/definitions/ab`
 * Fixed `$` in `patternProperties` matching before a trailing newline, which also made a `pattern` with the same regex accept a trailing newline
diff --git a/fastjsonschema/ref_resolver.py b/fastjsonschema/ref_resolver.py
index b0b0b29..84e80d1 100644
--- a/fastjsonschema/ref_resolver.py
+++ b/fastjsonschema/ref_resolver.py
@@ -35,8 +35,10 @@ def resolve_path(schema: Any, fragment: str) -> Any:
 
     Path is unescaped according https://tools.ietf.org/html/rfc6901
     """
-    fragment = fragment.lstrip('/')
-    parts = unquote(fragment).split('/') if fragment else []
+    if not fragment:
+        return schema
+    # Only one "/": each further one starts a token, and that token can be empty.
+    parts = unquote(fragment.removeprefix('/')).split('/')
     for part in parts:
         part = part.replace('~1', '/').replace('~0', '~')
         if isinstance(schema, list):
diff --git a/tests/test_ref_pointer.py b/tests/test_ref_pointer.py
new file mode 100644
index 0000000..c4965a0
--- /dev/null
+++ b/tests/test_ref_pointer.py
@@ -0,0 +1,82 @@
+import pytest
+
+from fastjsonschema import JsonSchemaValueException, compile, compile_to_code
+from fastjsonschema.ref_resolver import RefResolver, resolve_path
+
+
+@pytest.mark.parametrize('fragment, expected', [
+    ('/', {'child': 1, '': 2, 'a/b': 3, '~': 4, 'café': 5}),
+    ('//child', 1),
+    ('//', 2),
+    ('//a~1b', 3),
+    ('//~0', 4),
+    ('//caf%C3%A9', 5),
+])
+def test_empty_leading_pointer_tokens(fragment, expected):
+    schema = {'': {'child': 1, '': 2, 'a/b': 3, '~': 4, 'café': 5}}
+    assert resolve_path(schema, fragment) == expected
+
+
+def test_root_and_ordinary_pointer_tokens():
+    schema = {'items': [{'type': 'integer'}]}
+    assert resolve_path(schema, '') is schema
+    assert resolve_path(schema, '/items/0') == {'type': 'integer'}
+    assert resolve_path(schema, 'items/0') == {'type': 'integer'}
+
+
+@pytest.mark.parametrize('generated', [False, True])
+@pytest.mark.parametrize('ref, subschema', [
+    ('#/', {'type': 'integer'}),
+    ('#//child', {'child': {'type': 'integer'}}),
+    ('#//', {'': {'type': 'integer'}}),
+])
+def test_compile_references_through_empty_root_key(generated, ref, subschema):
+    schema = {
+        '': subschema,
+        'type': 'object',
+        'properties': {'value': {'$ref': ref}},
+    }
+    if generated:
+        namespace = {}
+        exec(compile_to_code(schema), namespace)
+        validator = namespace['validate']
+    else:
+        validator = compile(schema)
+
+    assert validator({'value': 42}) == {'value': 42}
+    with pytest.raises(JsonSchemaValueException):
+        validator({'value': 'wrong type'})
+
+
+@pytest.mark.parametrize('generated', [False, True])
+def test_empty_key_in_handler_loaded_schema(generated):
+    remote = {
+        '': {'type': 'integer'},
+        'type': 'object',
+        'properties': {'value': {'$ref': '#/'}},
+    }
+    schema = {'$ref': 'https://schemas.example/schema.json'}
+    handlers = {'https': lambda _uri: remote}
+    if generated:
+        namespace = {}
+        exec(compile_to_code(schema, handlers=handlers), namespace)
+        validator = namespace['validate']
+    else:
+        validator = compile(schema, handlers=handlers)
+
+    assert validator({'value': 42}) == {'value': 42}
+    with pytest.raises(JsonSchemaValueException):
+        validator({'value': 'wrong type'})
+
+
+def test_empty_key_scope_names_stay_unique_and_stable():
+    resolver = RefResolver.from_schema({})
+    root_name = resolver.get_scope_name()
+    with resolver.in_scope('#/'):
+        child_name = resolver.get_scope_name()
+        assert resolver.get_scope_name() == child_name
+    with resolver.in_scope('#//'):
+        grandchild_name = resolver.get_scope_name()
+    with resolver.in_scope('#'):
+        assert resolver.get_scope_name() == root_name
+    assert len({root_name, child_name, grandchild_name}) == 3
