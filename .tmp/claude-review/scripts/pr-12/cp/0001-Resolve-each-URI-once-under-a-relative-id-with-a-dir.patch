+    loaded = []
+
+    def handler(uri):
+        loaded.append(uri)
+        return {'type': 'integer'}
+
+    validator = compile({'$id': 'a/b/item.json', 'properties': {'x': {'$ref': 'other.json'}}}, handlers={'': handler})
+
+    assert validator({'x': 1}) == {'x': 1}
+    assert loaded == ['a/b/other.json']
+
+
+@pytest.mark.parametrize('ref', ['#', 'node.json'])
